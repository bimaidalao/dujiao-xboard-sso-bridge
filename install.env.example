# Copy to install.env and replace every example value before unattended use.
# Do not commit install.env if it contains private paths or domains.

XBOARD_DIR=/opt/xboard
DUJIAO_DB=/opt/dujiao-next/db/dujiao.db
DUJIAO_CONFIG=/opt/dujiao-next/config.yml

STORE_DOMAIN=store.example.com
PANEL_DOMAIN=panel.example.com
TELEGRAM_URL=https://t.me/example
TELEGRAM_HANDLE=@example

# Xboard production-style V1 Passport route class.
XBOARD_ROUTE_FILE=/opt/xboard/app/Http/Routes/V1/PassportRoute.php

# Leave empty for a native PHP deployment. The installer auto-detects a web
# container whose bind mount source equals XBOARD_DIR.
XBOARD_DOCKER_CONTAINER=
XBOARD_CONTAINER_DIR=/www

# Nginx file containing the HTTPS server block for STORE_DOMAIN.
STORE_NGINX_CONF=/etc/nginx/sites-available/store.example.com.conf

# Linux account used by the bridge. It must be able to read both config files
# and read/write the Dujiao SQLite database and its parent directory.
SERVICE_USER=www-data
SERVICE_GROUP=www-data

# Optional frontend integration. Leave empty for backend-only installation.
DUJIAO_PUBLIC_DIR=
DUJIAO_LAYOUT_FILE=
XBOARD_PUBLIC_DIR=
XBOARD_LAYOUT_FILE=

# Internal endpoints. Change only when the upstream services use other ports.
DUJIAO_IDENTITY_URL=http://127.0.0.1:18080/api/v1/me
XBOARD_USER_INFO_URL=http://127.0.0.1:7001/api/v1/user/info
BRIDGE_LISTEN=127.0.0.1:18081
