[Unit]
Description=Dujiao and Xboard SSO Bridge
After=network.target

[Service]
# Docker bridge 网络请让安装器生成实际监听地址和可信 CIDR，不要直接照抄本示例。
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/dujiao-xboard-sso-bridge/dujiao/public
EnvironmentFile=/etc/dujiao-xboard-sso-bridge.env
ExecStart=/usr/bin/php -S 127.0.0.1:18081 -t /opt/dujiao-xboard-sso-bridge/dujiao/public
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadOnlyPaths=/opt/xboard
ReadWritePaths=/opt/dujiao-next/db

[Install]
WantedBy=multi-user.target
