# Public URLs
DUJIAO_PUBLIC_URL=https://store.example.com/
XBOARD_PUBLIC_URL=https://panel.example.com/
XBOARD_PUBLIC_ORIGINS=https://panel.example.com

# Identity/profile endpoints may use the public HTTPS application URLs.
DUJIAO_IDENTITY_URL=https://store.example.com/api/v1/me
DUJIAO_CREDENTIAL_URL=http://127.0.0.1:18081/credential.php
XBOARD_USER_INFO_URL=https://panel.example.com/api/v1/user/info
BRIDGE_TRUSTED_CLIENTS=127.0.0.1,::1
XBOARD_ENV_PATH=/opt/xboard/.env

# Dujiao Next paths used by the reverse bridge.
DUJIAO_CONFIG_PATH=/opt/dujiao-next/config.yml
DUJIAO_DATABASE_PATH=/opt/dujiao-next/db/dujiao.db

# Optional browser labels.
STORE_LABEL=AI Tools Store
PANEL_LABEL=Subscription Dashboard
